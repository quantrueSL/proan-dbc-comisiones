# =============================================================================
# comisionesbi — conexión a datos (DESARROLLO LOCAL)
# Se inyecta como env_file en docker-compose.dev.yml. Cambios aquí solo
# requieren reiniciar dbc-comisionesbi-dev (no rebuild).
# =============================================================================

# --- BigQuery ---
# Mismo proyecto que el resto del grupo Proan (proan-quantrue). Tablas fuente
# ya mapeadas: D30_INTEGRATION (SAP crudo, incl. sap_bsad_cleared_items para
# cobro), D20_DIMENSION (dm_business_area, dm_cedis) — ver Comisiones_DBC_Borrador_Tecnico.md.
BQ_PROJECT_ID=proan-quantrue
BQ_LOCATION=us-west4
BQ_CREDENTIALS_PATH=/app/config/bq_credentials.json

# --- Caché del catálogo (GET /v1/comisionesbi/catalog) ---
# Sin caché, cada render de página del frontend dispara 2 jobs de BigQuery sobre
# datos de dimensión. En producción son 3600 s (ver service.yaml).
# En local se pone a 0 para desactivarla y ver los cambios de catálogo al
# instante, sin esperar el TTL ni reiniciar el contenedor.
CATALOG_CACHE_TTL_SECONDS=0

# --- Logging ---
# INFO ya deja ver la creación del cliente de BigQuery (proyecto, región y de
# dónde salen las credenciales). DEBUG añade el ruido de las librerías de Google.
LOG_LEVEL=INFO
