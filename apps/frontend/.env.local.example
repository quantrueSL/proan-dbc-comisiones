# Entorno para levantar el frontend SIN Docker (`pnpm dev` en apps/frontend).
#
#   cp .env.local.example .env.local
#
# Con `docker compose -f deploy/docker-compose.dev.yml up` este fichero no hace
# falta ni se usa: el entorno lo pone el compose y `.env.local` no está entre los
# volúmenes montados. Esto es solo para el atajo de levantar el frontend a mano.
#
# Ninguno de estos valores es un secreto de verdad: los de Firebase son públicos
# por diseño —viajan en el JavaScript del navegador de cualquiera que abra el
# login— y el de la cookie es el de desarrollo, que ya está escrito en el
# compose. Quien decide quién entra es la lista de Firestore (LOGIN.md §4).
#
# Los tres valores de Firebase están también en deploy/docker-compose.dev.yml y
# en deploy/cloudrun/service.yaml. Si cambian ahí, cambian aquí.

# Backend comisionesbi. Si no está levantado, las pantallas de datos enseñan su
# error y el login sigue funcionando igual.
COMISIONESBI_SERVICE_URL=http://localhost:8091

# Sesión (LOGIN.md §5). Sin HTTPS en local, la cookie no puede ser Secure.
SESSION_COOKIE_NAME=dbc_comisiones_session
SESSION_COOKIE_SECURE=false
SESSION_SECRET=dbc-comisiones-dev-session-secret-no-usar-en-produccion

# Usuarios técnicos (usuario/contraseña). Las rutas son relativas al directorio
# desde el que arranca el servidor, apps/frontend.
HTPASSWD_PATH=../../deploy/nginx/.htpasswd

# Lista de acceso en Firestore (LOGIN.md §4). En Cloud Run lo resuelve la
# identidad del servicio; aquí, la misma service account que usa el backend.
GOOGLE_APPLICATION_CREDENTIALS=../../config/bq_credentials.json
GCP_PROJECT=proan-quantrue
FIRESTORE_DATABASE_ID=proan-lista-mails
ACCESS_LIST_ID=dbc_comisiones_acceso

# Firebase Authentication (LOGIN.md §2), app web comisiones-dbc-frontend.
# Sin estas tres, getFirebaseWebConfig() devuelve null y el botón de Google no
# se pinta. localhost es dominio autorizado de serie en Firebase; la URL de
# Cloud Run hay que añadirla a mano después del primer despliegue.
FIREBASE_API_KEY=AIzaSyAcchQhwYV2RKGck3GQX6gOAsfdUThlTuc
FIREBASE_AUTH_DOMAIN=proan-quantrue.firebaseapp.com
FIREBASE_APP_ID=1:272166156031:web:24712b699cf9bf2750beca
