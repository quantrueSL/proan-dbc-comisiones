# Credenciales y secretos — nunca deben acabar comiteados.
.env
.env.*
!.env.example
config/bq_credentials.json
deploy/nginx/.htpasswd
*.key
*.pem

# Python (apps/comisionesbi)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node / Next.js (apps/frontend ya trae su propio .gitignore; esto es red
# de seguridad para el resto del repo).
node_modules/
.next/
*.tsbuildinfo

# Salidas y logs locales.
*.log
backup/
data/sql

# Ficheros que manda el cliente (Excel de comisiones, tarifas y diccionarios).
# Son suyos, llegan por correo y los vuelve a mandar cada vez que cambia algo:
# el repo versiona lo que sale de ellos (data/tablas_cliente/, generado por
# scripts/tablas_cliente.py), no el original.
reportes_proan/

# Volcados de contexto de sesión, no forman parte del proyecto.
contexto_claude_*.json