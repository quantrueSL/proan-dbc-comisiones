# Credenciales y secretos — nunca deben acabar comiteados.
.env
.env.*
!.env.example
config/bq_credentials.json
deploy/nginx/.htpasswd
*.key
*.pem

# Python (apps/comisionesbi)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

